{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "echo '[hearth] 文件已修改，记得运行相关测试验证没有漂移'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '[hearth] 会话结束检查：1) 是否违反了 AGENTS.md 里的约束？ 2) 是否有新的踩坑要记录到文档？ 3) git status 是否有未提交的变更？'"
          }
        ]
      }
    ]
  }
}
