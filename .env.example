# 复制这个文件：cp .env.example .env
# 然后填入真实的值，.env 文件不会被 git 追踪

# ── 必填：M1 需要 ──────────────────────────────────────────
# Anthropic API Key（网关转发用）
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key

# 数据库密码
HEARTH_DB_PASSWORD=replace-with-a-long-random-local-password

# M1 唯一受信 workspace root（绝对路径只允许由本机环境配置）
HEARTH_WORKSPACE_ROOT=/absolute/path/to/your/projects

# M1 明确允许 Claude Code 请求的模型 ID，逗号分隔
HEARTH_ANTHROPIC_ALLOWED_MODELS=replace-with-model-id

# ── 可选：M3 才需要 ───────────────────────────────────────
# 飞书 Bot
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=

# Telegram Bot
# TELEGRAM_BOT_TOKEN=

# ── 本地开发默认值（一般不需要改）────────────────────────
# 网关端口（默认 4517）
# HEARTH_PORT=4517

# 数据库连接（默认本地 Docker）
# HEARTH_DB_HOST=localhost
# HEARTH_DB_PORT=5432
# HEARTH_DB_NAME=hearth
# HEARTH_DB_USER=hearth
